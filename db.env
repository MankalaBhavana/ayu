# =============================================================================
# PostgreSQL container settings (used by docker-compose.yml -> service "db")
# Replace the placeholder password before deploying. Do NOT commit real values.
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=hospital

# ---- Time zone ---------------------------------------------------------------
# Optional for correctness: timestamps are stored as TIMESTAMPTZ (UTC
# internally) and the app sets Asia/Kolkata on every connection itself.
# These only make the server default, logs and psql/admin sessions show IST.
TZ=Asia/Kolkata
PGTZ=Asia/Kolkata
