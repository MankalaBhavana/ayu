# Session Configuration
SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=1
SESSION_PEPPER=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Admin Route Auth
ADMIN_ROUTE_PASSWORD=change-me
ADMIN_ROUTE_AUTH_COOKIE_NAME=hospai_admin_route_auth
ADMIN_ROUTE_AUTH_TTL_SECONDS=3600
ADMIN_ROUTE_AUTH_SECRET=change-me-to-a-long-random-string

# Database
DB_ENGINE=postgres
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/hospital
DEFAULT_HOSPITAL_CODE=hosp-default

# Default Admin Account (created on first run if no users exist)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# Platform Superadmin (optional)
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# Clinic / Hospital Details & Branding (Backend PDF & Exports)
