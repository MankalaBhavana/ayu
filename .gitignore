# Environment secrets — never commit real credentials.
# db.env / app.env are committed as templates with placeholder values only;
# keep real values out of git (e.g. `git update-index --skip-worktree db.env app.env`).
.env
.env.*
*.env
!db.env
!app.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
htmlcov/
.coverage
*.egg-info/

# Node
node_modules/
.vite/

# frontend/dist/ is intentionally committed: backend/main.py serves it
# directly, so the repo runs out of the box with just the backend started.

# Local database dumps and rebuild backups — contain real data, never commit
backups/

# Database files
*.db

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE / tooling configs (not needed in production)
pyrefly.toml
.idea/
.vscode/

# Runtime logs and local tunnel binary
*.log
cloudflared.exe

# Scratch / temporary scripts
scratch/

# User uploads (runtime data, not source)
backend/uploads/*
!backend/uploads/.gitkeep
