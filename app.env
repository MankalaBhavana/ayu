# =============================================================================
# Backend application settings (docker-compose.yml -> service "backend").
# For local runs without Docker, backend/database.py also loads this file.
# Replace every "change-me" value before deploying. Do NOT commit real secrets.
# =============================================================================

# ---- Database ----------------------------------------------------------------
# User/password/db must match db.env. Host "db" is the compose service name;
# use 127.0.0.1 when running the backend locally.
DATABASE_URL=postgresql://postgres:change-me-db-password@db:5432/hospital
DEFAULT_HOSPITAL_CODE=hosp-default

# ---- Time zone ---------------------------------------------------------------
# Process time zone (logs, OS clock). Not required for correctness: the app
# always stores TIMESTAMPTZ and works in IST (Asia/Kolkata) by design, so do
# not change this to another zone.
TZ=Asia/Kolkata

# ---- Sessions ----------------------------------------------------------------
SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=1
SESSION_PEPPER=change-me-to-a-long-random-string
# true when served over HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# ---- Admin route auth --------------------------------------------------------
ADMIN_ROUTE_PASSWORD=change-me
ADMIN_ROUTE_AUTH_COOKIE_NAME=hospai_admin_route_auth
ADMIN_ROUTE_AUTH_TTL_SECONDS=3600
ADMIN_ROUTE_AUTH_SECRET=change-me-to-a-long-random-string

# ---- Default accounts (created on first run if no users exist) ---------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
ONBOARDING_ADMIN_USERNAME=
ONBOARDING_ADMIN_PASSWORD=
# Platform superadmin (optional; enables /api/platform/* routes)
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# ---- CORS (comma-separated extra origins) ------------------------------------
CORS_ALLOWED_ORIGINS=

# ---- Clinic details (backend PDF / Word exports) -----------------------------
CLINIC_NAME=Ayu Polyclinic & Emergency Clinic
CLINIC_TAGLINE=POLYCLINIC & DIAGNOSTICS
CLINIC_DOCTOR_NAME=Dr. Sushanth. B
CLINIC_DOCTOR_QUALIFICATIONS=MBBS (Gandhi), (FCCM)
CLINIC_DOCTOR_REG_NO=TSMC/FM/27444
CLINIC_ADDRESS_LINE1=GGF2+2F8, Old Alwal Road, Jonnabanda,
CLINIC_ADDRESS_LINE2=Chetana Housing Colony, Brundavan Colony,
CLINIC_ADDRESS_LINE3=Bollaram - 500010, Hyderabad.
CLINIC_PHONE=+91 6303346810
CLINIC_EMAIL=dr.sushanth108@gmail.com

# ---- Payments: Razorpay (optional) -------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Document storage: S3-compatible (optional) ------------------------------
# Leave commented to store uploads locally (backend uploads volume).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_VIRTUAL_HOSTED=false
# BUCKET_URL=

# ---- OCR / AI: Google Gemini (optional) --------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
